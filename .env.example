# TELEGRAM (crea il bot con @BotFather, il chat id lo ottieni da @userinfobot)
TELEGRAM_TOKEN=
CHAT_ID=

# SORARE - consigliata: API key da https://sorare.com/settings/developer
SORARE_API_KEY=

# SORARE - facoltativo: login con email/password (non funziona con la 2FA attiva)
SORARE_EMAIL=
SORARE_PASSWORD=
AUDIENCE=
USE_PASSWORD_LOGIN=1

# Opzioni
USER_AGENT=sorare-sniper-bot/2.0
# DRY_RUN=1 stampa le notifiche a schermo invece di inviarle
DRY_RUN=0
LOG_LEVEL=INFO
