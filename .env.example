# TELEGRAM (crea il bot con @BotFather, il chat id lo ottieni da @userinfobot)
TELEGRAM_TOKEN=
CHAT_ID=

# SORARE - API key da https://sorare.com/settings/developer
# (il bot non usa mai email e password del tuo account)
SORARE_API_KEY=

# Opzioni
USER_AGENT=sorare-sniper-bot/2.0
# DRY_RUN=1 stampa le notifiche a schermo invece di inviarle
DRY_RUN=0
LOG_LEVEL=INFO
